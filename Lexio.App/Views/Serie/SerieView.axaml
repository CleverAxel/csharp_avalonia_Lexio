<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Lexio.App.Views.Serie.SerieView"
             xmlns:serie="clr-namespace:Lexio.App.ViewModels.Serie"
             xmlns:dictionary="clr-namespace:Lexio.App.ViewModels.Dictionary.Language"
             x:DataType="serie:SerieViewModel">

    <UserControl.Styles>
        <Style Selector="Button.Base">
            <Setter Property="Padding" Value="10"></Setter>
        </Style>
        <Style Selector="Button.Delete /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DangerColor}" />
            <Setter Property="Width" Value="40"></Setter>
            <Setter Property="Height" Value="40"></Setter>
        </Style>
        <Style Selector="Button.Delete:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DangerHoverColor}" />
        </Style>

        <Style Selector="Button.Edit /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource InfoColor}" />
            <Setter Property="Width" Value="40"></Setter>
            <Setter Property="Height" Value="40"></Setter>
        </Style>
        <Style Selector="Button.Edit:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource InfoColorHover}" />
        </Style>

        <Style Selector="Button.Play /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SuccessColor}" />
            <Setter Property="Width" Value="40"></Setter>
            <Setter Property="Height" Value="40"></Setter>
        </Style>
        <Style Selector="Button.Play:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SuccessHoverColor}" />
        </Style>

        <Style Selector="ComboBox:focus">
            <Setter Property="Foreground" Value="Black"></Setter>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="White"></Setter>
            <Setter Property="Foreground" Value="{StaticResource BgColor}"></Setter>
            <Setter Property="FontSize" Value="20"></Setter>
            <Setter Property="Padding" Value="10"></Setter>
        </Style>
        <Style Selector="ComboBox:pressed /template/ Border#Background">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="White" />
        </Style>

    </UserControl.Styles>

    <Grid RowDefinitions="Auto, *">
        <Border BorderBrush="White" BorderThickness="0 0 0 5">
            <Grid ColumnDefinitions="Auto, *">
                <Border Padding="10" BorderBrush="White" BorderThickness="0">
                    <StackPanel Orientation="Vertical" Spacing="5">
                        <TextBlock FontSize="20" FontWeight="Bold">Ajouter une nouvelle série :</TextBlock>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Width="300" Classes="Base" x:Name="NewSerieTextInput" VerticalAlignment="Center"
                                     Name="NewSerieTextInput"
                                     Text="{Binding NewSerieName}" />
                            <ComboBox Width="240"
                                      ItemsSource="{Binding AvailableLanguageModels}"
                                      SelectedItem="{Binding SelectedSerieLanguage}"
                                      PlaceholderText="Langue...">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type dictionary:LanguageViewModel}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Foreground="Black" Text="{Binding Flag}" />
                                            <TextBlock Foreground="Black" Text="{Binding Name}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <Button Classes="Base" HorizontalAlignment="Stretch" Command="{Binding AddNewSerieCommand}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                                <TextBlock>Ajouter</TextBlock>
                                <PathIcon Width="20" Height="35" Foreground="White"
                                          Data="{StaticResource AddSquareRegular}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1">
                    <Button Margin="0 0 30 0" HorizontalAlignment="Right" Classes="Base" Command="{Binding RoutingService.GoSerieResultCommand}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center">Résultats des séries</TextBlock>
                            <TextBlock HorizontalAlignment="Center">📈</TextBlock>
                        </StackPanel>

                    </Button>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="1" Padding="10">
            <ListBox ItemsSource="{Binding AvailableSeries}"
                     Background="Transparent"
                     HorizontalAlignment="Left">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"
                                   ItemSpacing="2"
                                   LineSpacing="2" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="MinHeight" Value="0" />
                        <Setter Property="MinWidth" Value="0" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10"
                                MinWidth="240"
                                CornerRadius="15"
                                Background="{StaticResource ButtonColor}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top">
                            <StackPanel Orientation="Vertical">
                                <Grid ColumnDefinitions="Auto, *">
                                    <TextBlock Text="{Binding LanguageFlag}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                                Spacing="5">
                                        <Button Classes="Base Play"
                                                Command="{Binding $parent[ListBox].((serie:SerieViewModel)DataContext).PlayCommand}"
                                                CommandParameter="{Binding .}">
                                            <PathIcon Width="15" Height="15" Foreground="White"
                                                      Data="{StaticResource PlayRegular}" />
                                        </Button>
                                        <Button Classes="Base Edit"
                                                Command="{Binding $parent[ListBox].((serie:SerieViewModel)DataContext).TestCommand}"
                                                CommandParameter="{Binding .}">
                                            <PathIcon Width="15" Height="15" Foreground="White"
                                                      Data="{StaticResource EditRegular}" />
                                        </Button>
                                        <Button Classes="Base Delete"
                                                Command="{Binding $parent[ListBox].((serie:SerieViewModel)DataContext).DeleteCommand}"
                                                CommandParameter="{Binding .}">
                                            <PathIcon Width="15" Height="15" Foreground="White"
                                                      Data="{StaticResource DeleteRegular}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Margin="0 10 0 0" Orientation="Vertical">
                                    <TextBlock FontSize="20" FontWeight="Bold">Série :</TextBlock>
                                    <TextBlock FontStyle="Italic" Text="{Binding Name}" />
                                </StackPanel>
                                <StackPanel Margin="0 10 0 0" Orientation="Vertical">
                                    <TextBlock FontSize="20" FontWeight="Bold">Nombre de mot(s) dans cette série :</TextBlock>
                                    <TextBlock Classes="PrimaryFont" Foreground="White" FontStyle="Italic" Text="{Binding WordCount}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>